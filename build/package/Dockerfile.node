FROM golang:1.27 AS builder

RUN apt install git

COPY . /go/src/github.com/yandex-cloud/yc-csi-driver
WORKDIR /go/src/github.com/yandex-cloud/yc-csi-driver

RUN REVISION=$(git rev-parse HEAD) && \
    CGO_ENABLED=0 go build -a -ldflags '-X github.com/yandex-cloud/yc-csi-driver/pkg/version.gitRevision=${REVISION}' \
    -o /go/bin/yc-csi-driver-node github.com/yandex-cloud/yc-csi-driver/cmd/node

FROM alpine:3.24.4

RUN apk add --no-cache util-linux e2fsprogs blkid e2fsprogs-extra btrfs-progs

COPY --from=builder /go/bin/yc-csi-driver-node /bin/yc-csi-driver-node

ENTRYPOINT ["/bin/yc-csi-driver-node"]
 